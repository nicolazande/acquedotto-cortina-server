{
  "name": "server",
  "version": "2.0.0",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-api.js",
    "report:tutti": "npm run report:formule && npm run report:integrita && npm run report:anteprima && npm run report:quota-fissa && npm run report:storico",
    "report:calcolo": "node scripts/verify-billing-calculator.js",
    "report:formule": "node scripts/verify-billing-formulas.js",
    "report:storico": "node scripts/verify-historical-invoice-calculation.js",
    "report:anteprima": "node scripts/verify-new-invoice-preview.js",
    "report:portale": "node scripts/verify-customer-portal-users.js",
    "report:quota-fissa": "node scripts/verify-fixed-charge-actions.js",
    "report:operazioni": "node scripts/verify-invoice-operations.js",
    "report:integrita": "node scripts/verify-invoice-integrity.js",
    "maintenance:user-indexes": "node scripts/ensure-user-indexes.js",
    "maintenance:allinea-dati": "node scripts/allinea-dati.js",
    "seed:articoli": "node scripts/seed-articoli.js",
    "gesco:login": ".venv/bin/python documents/script/login_gesco.py",
    "gesco:import": ".venv/bin/python documents/script/main.py"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "nodemon": "^2.0.7"
  }
}
