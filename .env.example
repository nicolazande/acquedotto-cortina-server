PORT=5000
MONGODB_URI=mongodb://localhost:27017/acquedotto-zuel
MONGODB_DB=acquedotto-zuel
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
MONGODB_TLS=
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGODB_DIRECT_CONNECTION=
# Obbligatorio fuori dallo sviluppo, e i valori di esempio vengono rifiutati:
# generarne uno con
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
MAX_ADMIN_USERS=2
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
REQUEST_BODY_LIMIT=10mb
# Tetto ai record restituiti da una singola richiesta di elenco.
MAX_PAGE_SIZE=500
# Freno ai tentativi di accesso falliti, per indirizzo e nome utente.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000
ATTACHMENT_MAX_BYTES=6291456
INVOICE_DUE_DAYS=30
# Serie di numerazione dei documenti emessi da questo gestionale.
# Lo storico importato non ha serie: il suo campo numero e un codice cliente.
INVOICE_SERIES=A
# Dati del cedente per la fattura elettronica.
INVOICE_VAT_NUMBER=00296800253
INVOICE_TAX_CODE=00296800253
# RF01 = regime ordinario. Da confermare con chi tiene la contabilita.
INVOICE_TAX_REGIME=RF01
INVOICE_ADDRESS=Pian de Lago, 64
INVOICE_ZIP=32043
INVOICE_CITY=Cortina d'Ampezzo
INVOICE_PROVINCE=BL
INVOICE_DELAY_FEE=6
INVOICE_COMPANY_NAME=COOPERATIVA DI GESTIONE ACQUEDOTTO ZUEL DI SOPRA
INVOICE_COMPANY_FOOTER=COOPERATIVA DI GESTIONE ACQUEDOTTO - Pian de Lago, 64 32043 CORTINA D AMPEZZO (BL) - C.F./P.I. 00296800253 - R.E.A. Belluno 65393
INVOICE_COMPANY_WEBSITE=www.acquedottozuel.it
INVOICE_COMPANY_EMAIL=acquedottozuel@gmail.com
INVOICE_PHONE_DIRECT=0436 867504
INVOICE_BANK_NAME=CORTINA BANCA Credito cooperativo Italiano
INVOICE_IBAN=IT11M 08511 61070 0000 0000 6953
FASTTOOLS_EMAIL=
FASTTOOLS_PASSWORD=
FASTTOOLS_SESSION_COOKIE=
FASTTOOLS_BASE_URL=https://zuel.fast.tools
FASTTOOLS_TIMEOUT_SECONDS=45
FASTTOOLS_RETRIES=4
FASTTOOLS_RETRY_BACKOFF_SECONDS=3
IMPORT_VERBOSE=false
IMPORT_RESET_DB=false
IMPORT_HEADLESS=false
IMPORT_STEPS=listini,articoli,clienti,edifici,scadenze,fatture
IMPORT_LISTINI_WORKERS=8
IMPORT_CLIENTI_WORKERS=12
IMPORT_EDIFICI_WORKERS=12
IMPORT_FATTURE_WORKERS=12
IMPORT_SCADENZE_MAX_PAGES=28
LOCAL_MONGODB_URI=mongodb://localhost:27017/acquedotto-zuel
LOCAL_MONGODB_DB=acquedotto-zuel
REMOTE_MONGODB_URI=
REMOTE_MONGODB_DB=acquedotto-zuel
SYNC_DIRECTION=pull
SYNC_COLLECTIONS=articoli,clienti,contatori,edifici,fasce,fatture,letture,listini,scadenze,servizi,note_attachments
SYNC_BATCH_SIZE=500
SYNC_DELETE_MISSING=false
SYNC_INCLUDE_USERS=false
SYNC_DRY_RUN=false

# --- Consegna delle fatture -------------------------------------------------
# Nessuna email parte finche INVIO_EMAIL_ABILITATO non vale true E il server
# SMTP non e configurato: servono entrambe le condizioni insieme.
INVIO_EMAIL_ABILITATO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
INVIO_MITTENTE=
INVIO_MITTENTE_NOME=
# Quante connessioni e quanti messaggi per connessione verso il server di posta.
# Aprirne una per ogni fattura significa farsi chiudere la porta in faccia.
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=50
INVIO_RISPOSTE_A=
# Rete di sicurezza per le prove: se valorizzata, ogni messaggio va a questo
# indirizzo invece che al cliente, con il destinatario vero scritto nell'oggetto.
INVIO_DESTINATARIO_PROVA=
# Chi trasmette allo SdI. "intermediario" (commercialista o portale
# dell'Agenzia) significa che il gestionale prepara il file ma non lo inoltra;
# "pec" lo inoltra da solo alla casella dello SdI.
CANALE_TRASMISSIONE_SDI=intermediario
SDI_PEC_DESTINATARIO=sdi01@pec.fatturapa.it
# Interruttore unico per attivare la fattura elettronica su tutti i clienti,
# al posto del flag su ogni singola anagrafica.
FATTURA_ELETTRONICA_PREDEFINITA=false
